# -------------------------------------------------------
# Environment Variables for URL Shortener
# -------------------------------------------------------
# Copy this file to .env and fill in the values.
# These are used in production (Render) and optionally locally.

# PostgreSQL connection string (required in production)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Flask debug mode (set to "true" for local development only)
FLASK_DEBUG=false

# Port (Render sets this automatically; default 5000 locally)
PORT=5000
